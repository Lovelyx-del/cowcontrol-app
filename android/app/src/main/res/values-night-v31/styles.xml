<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mismo splash que values-v31/styles.xml, para cuando el celular tiene
         el modo oscuro del sistema activado — la app no tiene tema oscuro
         propio, asi que se mantiene el mismo fondo crema sin icono en los
         dos casos, para no tener un flash de color distinto. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/fondo_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
